#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <150>;
        };

        shifthr: shifthr {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFTHR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <185>;
            flavor = "tap-preferred";
            quick-tap-ms = <185>;
        };

        weak: weak {
            compatible = "zmk,behavior-hold-tap";
            label = "WEAK";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <230>;
        };
    };

    combos {
        compatible = "zmk,combos";

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <0 1>;
        };

        underscore_right {
            bindings = <&kp MINUS>;
            key-positions = <11 10>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <16 19>;
            timeout-ms = <30>;
        };

        backlash {
            bindings = <&kp BACKSLASH>;
            key-positions = <23 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&lt 4 ESCAPE   &lt 3 Q           &lt 1 W             &kp E           &kp R               &kp T                   &kp Y  &kp U                &kp I               &kp O                &kp P                      &mt MINUS BACKSPACE
&mt LSHFT TAB  &hm LEFT_SHIFT A  &hm LEFT_COMMAND S  &hm LEFT_ALT D  &hm LEFT_CONTROL F  &kp G                   &kp H  &hm RIGHT_CONTROL J  &hm RIGHT_ALT K     &hm RIGHT_COMMAND L  &hm RIGHT_SHIFT SEMICOLON  &mt BACKSLASH ENTER
&kp LEFT_GUI   &kp Z             &kp X               &kp C           &kp V               &kp B                   &kp N  &kp M                &kp COMMA           &kp DOT              &kp SLASH                  &lt 5 SQT
                                                     &lt 3 DELETE    &kp ENTER                  &lt 1 BACKSPACE         &lt 2 SPACE          &mt GRAVE CAPSLOCK
            >;
        };

        numbers_fs {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &kp N7  &kp N8        &kp N9  &kp PLUS      &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &kp N4  &kp N5        &kp N6  &kp ASTERISK  &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &kp N1  &kp N2        &kp N3  &kp PERIOD    &kp COMMA  &trans
                        &trans  &trans          &trans          &kp NUMBER_0  &trans
            >;
        };

        arrows_multi {
            bindings = <
&kp LA(LEFT_GUI)  &kp LS(LEFT_GUI)  &kp LG(LS(NUMBER_4))  &kp LG(LC(LS(NUMBER_4)))  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC          &kp HOME       &kp END   &kp UP    &trans     &trans  &trans
&trans            &trans            &trans                &hm LALT C_MUTE           &kp C_VOL_DN          &kp C_VOLUME_UP               &kp PAGE_UP    &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans            &trans            &trans                &kp C_PREV                &kp C_PLAY            &kp C_NEXT                    &kp PAGE_DOWN  &trans    &trans    &trans     &trans  &trans
                                                          &trans                    &trans                                      &trans                 &trans    &trans
            >;
        };

        coding_symb {
            bindings = <
&trans  &none   &kp LA(LG(LEFT_ARROW))  &kp LG(LA(RIGHT_ARROW))  &kp LG(W)  &none           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE            &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans  &trans  &trans                  &trans                   &none      &none           &kp LEFT_ARROW        &kp UP_ARROW           &kp DOWN_ARROW            &kp RIGHT        &kp DELETE        &trans
&trans  &none   &none                   &trans                   &none      &trans          &kp HOME              &kp PAGE_UP            &kp PAGE_DOWN             &kp END          &trans            &trans
                                        &kp LS(LG(NUMBER_4))     &trans             &trans                        &trans                 &kp LG(LC(LS(NUMBER_4)))
            >;
        };

        numbers_top {
            bindings = <
&trans  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5               &kp NUMBER_6  &kp N7         &kp N8        &kp N9                &kp N0                 &kp BACKSPACE
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT          &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&kp F1  &kp F2           &kp F3        &kp F4        &kp F5        &kp F6               &kp F7        &kp F8         &kp F9        &kp F10               &kp F11                &kp F12
                                       &trans        &trans                     &trans                &trans         &trans
            >;
        };

        admin {
            bindings = <
&bl BL_TOG       &bl BL_INC       &bl BL_DEC       &bl BL_CYCLE     &trans           &trans                   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &trans                   &trans        &trans        &trans        &trans        &trans        &none
&rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD          &trans        &trans        &trans        &trans        &trans        &bt BT_CLR
                                                   &trans           &trans                            &trans                &sys_reset    &bootloader
            >;
        };
    };
};
